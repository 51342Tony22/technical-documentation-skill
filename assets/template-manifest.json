{
  "patent": {
    "prompt": "references/patent-prompt.md",
    "deliverable_policy": "Only produce the supplied computer-related patent technical disclosure form. Do not produce claims or a final patent application unless the project owner changes the scope.",
    "output_documents": [
      {
        "id": "technical-disclosure",
        "template": "assets/templates/patent-technical-disclosure.docx",
        "sha256": "adb922ad76ae4fbaeec1d79e9f0c42aaae2cec584d80583ea84b89bb62d7b67c",
        "output_filename": "专利技术交底书.docx",
        "required_sections": [
          "申请类别",
          "申请人",
          "发明人或设计人",
          "联系人及联系方式",
          "发明创造名称",
